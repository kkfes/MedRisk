# Frontend environment variables (Vite).
#
# Copy this file to `frontend/.env.local` and adjust the values locally.
# `.env.local` is ignored by Git — never commit real secrets or real URLs.
#
# Note: every variable prefixed with VITE_ is embedded into the browser bundle,
# so only non-sensitive values may be placed here.

# Which API adapter the application uses:
#   mock — the in-browser mock adapter (illustrative example data, no backend needed)
#   live — the HTTP client against VITE_API_BASE_URL
VITE_API_MODE=mock

# Base URL of the MedRisk REST API. Only used when VITE_API_MODE=live.
# The value below is the local development address of the FastAPI backend (DIP-18).
VITE_API_BASE_URL=http://127.0.0.1:8000
